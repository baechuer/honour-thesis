# Local API keys for optional provider-based benchmark baselines.
# Copy this file to `.env`, fill only the providers you want to test,
# then run `source .env` before running API selector scripts.

# OpenAI embeddings, for example text-embedding-3-small or text-embedding-3-large.
OPENAI_API_KEY=

# DeepSeek model-assisted public skill field verification.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen Cloud / DashScope compatible-mode embeddings and qwen3-rerank.
DASHSCOPE_API_KEY=

# Optional alternative embedding/reranking providers for later experiments.
COHERE_API_KEY=
VOYAGE_API_KEY=
JINA_API_KEY=

# Optional Hugging Face token if you later download/use gated hosted models.
HF_TOKEN=
