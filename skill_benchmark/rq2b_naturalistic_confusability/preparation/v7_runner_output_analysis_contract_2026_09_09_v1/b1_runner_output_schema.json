{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rq2b-v7-b1-runner-output-v1",
  "title": "RQ2b V7 label-free first-stage runner output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "run_id", "condition_id",
    "first_stage_cell_id", "prompt_id", "prompt_sha256",
    "representation", "retriever", "persisted_candidate_source",
    "source_union_sha256", "top_k", "score_semantics",
    "top20_binding_sha256", "ranked_candidates", "cost"
  ],
  "properties": {
    "schema_version": {"const": "rq2b-v7-b1-runner-output-v1"},
    "status": {"const": "SUCCESS"},
    "run_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "pattern": "^B(0[1-9]|1[0-2])-G0$"},
    "first_stage_cell_id": {"type": "string", "pattern": "^B(0[1-9]|1[0-2])$"},
    "prompt_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "representation": {"type": "string", "minLength": 1},
    "retriever": {"type": "string", "minLength": 1},
    "persisted_candidate_source": {"type": "string", "pattern": "^B(0[1-9]|1[0-2])$"},
    "source_union_sha256": {"$ref": "#/$defs/sha256"},
    "top_k": {"const": 100},
    "score_semantics": {"const": "HIGHER_IS_BETTER"},
    "top20_binding_sha256": {"$ref": "#/$defs/sha256"},
    "ranked_candidates": {
      "type": "array", "minItems": 100, "maxItems": 100,
      "items": {"$ref": "#/$defs/rankedCandidate"}
    },
    "cost": {"$ref": "#/$defs/cost"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rankedCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "source_sha256", "score"],
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 100},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "score": {"type": "number"}
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_time_ms", "provider_calls", "input_tokens", "output_tokens", "window_forwards", "cache_hits", "retry_count", "timeout_count", "failure_count"],
      "properties": {
        "wall_time_ms": {"type": "number", "minimum": 0},
        "provider_calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "window_forwards": {"type": "integer", "minimum": 0},
        "cache_hits": {"type": "integer", "minimum": 0},
        "retry_count": {"type": "integer", "minimum": 0},
        "timeout_count": {"type": "integer", "minimum": 0},
        "failure_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
